---
import '../styles/global.css'
import ThemeToggle from '../components/ThemeToggle.astro'

interface Props {
  title: string
  description?: string
}

export const SITE_DESCRIPTION =
  'システム開発、Webサイト制作、技術相談などを行っています。「こんなものを作りたい」を形にします。お気軽にお問い合わせください。'

const { title, description = SITE_DESCRIPTION } = Astro.props

const fullTitle = `${title} | Yuuniworks`

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL('/og-image.png', Astro.site)

const pathname = Astro.url.pathname
const isAbout = pathname === '/'
const isBlog = pathname.startsWith('/blog')
const isContact = pathname.startsWith('/contact')
---

<html lang="ja" class="bg-surface text-content">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={fullTitle} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+JP:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      var theme =
        localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light')
      localStorage.setItem('theme', theme)
      document.documentElement.setAttribute('data-theme', theme)
    </script>
  </head>
  <body class="font-sans text-base antialiased">
    <nav
      class="sticky top-0 z-50 h-14 flex items-center justify-between px-8 border-b border-border bg-surface/85 backdrop-blur-md"
    >
      <a href="/" class="opacity-60 hover:opacity-100 transition-opacity">
        <img
          src="/logo.svg"
          alt="YUUNIWORKS"
          class="h-6 select-none"
          draggable="false"
        />
      </a>
      <div class="flex items-center gap-5 sm:gap-7">
        <div class="hidden sm:flex gap-7">
          <a
            href="/"
            class:list={[
              'nav-underline font-sans text-small transition-colors',
              isAbout ? 'active text-content' : 'text-muted hover:text-content',
            ]}>About</a
          >
          <a
            href="/blog"
            class:list={[
              'nav-underline font-sans text-small transition-colors',
              isBlog ? 'active text-content' : 'text-muted hover:text-content',
            ]}>Blog</a
          >
          <a
            href="/contact"
            class:list={[
              'nav-underline font-sans text-small transition-colors',
              isContact
                ? 'active text-content'
                : 'text-muted hover:text-content',
            ]}>Contact</a
          >
        </div>
        <ThemeToggle />
      </div>
    </nav>

    <slot />

    <footer class="max-w-3xl mx-auto px-8 py-8">
      <span class="font-mono text-small text-muted">© 2026 Shota Tamura</span>
    </footer>
  </body>
</html>
