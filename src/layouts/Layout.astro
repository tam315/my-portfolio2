---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Shota Tamura — yuuniworks' } = Astro.props;

const pathname = Astro.url.pathname;
const isAbout = pathname === '/';
const isBlog = pathname.startsWith('/blog');
---

<html lang="ja" class="bg-surface text-content">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+JP:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans text-base antialiased">

    <nav class="sticky top-0 z-50 h-14 flex items-center justify-between px-8 border-b border-border bg-surface/85 backdrop-blur-md">
      <a href="/" class="opacity-60 hover:opacity-100 transition-opacity">
        <img src="/logo.svg" alt="YUUNIWORKS" class="h-6 select-none" draggable="false" />
      </a>
      <div class="hidden sm:flex gap-7">
        <a
          href="/"
          class:list={['nav-underline font-sans text-small transition-colors', isAbout ? 'active text-content' : 'text-muted hover:text-content']}
        >About</a>
        <a
          href="/blog"
          class:list={['nav-underline font-sans text-small transition-colors', isBlog ? 'active text-content' : 'text-muted hover:text-content']}
        >Blog</a>
      </div>
    </nav>

    <slot />

    <footer class="max-w-3xl mx-auto px-8 py-8">
      <span class="font-mono text-small text-muted">© 2026 Shota Tamura</span>
    </footer>

  </body>
</html>
